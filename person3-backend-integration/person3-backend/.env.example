# Copy to .env locally; source it before starting (no automatic dotenv loader).
DATABASE_URL=sqlite:///./tickets.db
# Fine-grained GitHub PAT: Contents read/write and Pull requests read/write.
GITHUB_TOKEN=
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Human-only credential: never supply to Switch, an LLM, or embed in frontend JS.
HUMAN_APPROVAL_TOKEN=
HUMAN_APPROVER_ID=hackathon-reviewer
CORS_ORIGINS=http://localhost:5173
VERIFIER_IMAGE=support-fix-verifier:local
# app.py for standalone demo repository; demo-repo/app.py for this monorepo.
MOCK_PATCH_PATH=demo-repo/app.py
VERIFIER_PROJECT_DIR=demo-repo
